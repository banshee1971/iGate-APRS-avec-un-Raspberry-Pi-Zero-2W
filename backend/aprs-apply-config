def action_network(env, payload=''):
    """Active un profil réseau (payload : « <id> » ou « <id> --no-confirm »)."""
    parts = payload.split()
    if not parts or not re.fullmatch(r'[a-z0-9-]{1,32}', parts[0]):
        return False, 'Profil réseau invalide.'
    cmd = ['/usr/local/sbin/aprs-network', 'apply', parts[0]]
    if '--no-confirm' in parts[1:]:
        cmd.append('--no-confirm')
    r = run(cmd, capture_output=True, text=True)
    return r.returncode == 0, (r.stdout.strip().splitlines() or ['?'])[-1]


def action_network_confirm(env, payload=''):
    r = run(['/usr/local/sbin/aprs-network', 'confirm'], capture_output=True, text=True)
    return r.returncode == 0, (r.stdout.strip().splitlines() or ['?'])[-1]


def action_clear_tiles(env):
    if os.path.isdir(TILE_DIR):
        for name in os.listdir(TILE_DIR):
            path = os.path.join(TILE_DIR, name)
            if name.isdigit() and os.path.isdir(path):   # dossiers de zoom seulement
                shutil.rmtree(path)
    return True, 'Cache des tuiles vidé.'


def action_reboot(env):
    write_status('reboot', True, 'Redémarrage du Pi en cours...')
    run(['systemctl', 'reboot'])
    return True, 'Redémarrage du Pi en cours...'


# ------------------------------------------------------------ mises à jour
# La recherche se fait ici (1 à 2 minutes). Les mises à jour elles-mêmes
# tournent dans une unité systemd transitoire, séparée d'aprs-admin.service :
# install.sh réinstalle ce script et relance nginx/PHP, et une mise à jour
# du système peut durer longtemps sans bloquer les autres demandes.
def write_json(path, data):
    tmp = path + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(data, f, ensure_ascii=False, indent=1)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def read_json(path, default=None):
    try:
        with open(path, encoding='utf-8') as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def kit_dir(env):
    """Dossier git du kit (noté par install.sh, sinon emplacement du guide)."""
    for d in (env.get('KIT_DIR', ''), os.path.join(env['IGATE_HOME'], KIT_NAME)):
        if d and os.path.isdir(os.path.join(d, '.git')) and os.path.isfile(os.path.join(d, 'install.sh')):
            return d
    return None


def repo_owner(d):
    """Propriétaire du dossier du kit (pi, ou root s'il a été cloné dans /root)."""
    try:
        return pwd.getpwuid(os.stat(d).st_uid).pw_name
    except (OSError, KeyError):
        return 'root'


def as_owner(d, cmd):
    """git tourne sous le propriétaire du dossier : sinon accès refusé
    (dossier dans /root) ou « dubious ownership » (git refuse le dépôt)."""
    owner = repo_owner(d)
    return cmd if owner == 'root' else ['runuser', '-u', owner, '--'] + cmd


def reboot_needed():
    """Vrai si un paquet demande un redémarrage ou si un nouveau noyau a été installé."""
    if os.path.exists('/run/reboot-required'):
        return True
    try:
        with open('/proc/uptime') as f:
            boot = datetime.now().timestamp() - float(f.read().split()[0])
        running = os.uname().release
        for name in os.listdir('/lib/modules'):
            path = os.path.join('/lib/modules', name)
            if name != running and os.path.getmtime(path) > boot + 60:
                return True
    except (OSError, ValueError):
        pass
    return False


def check_os():
    envc = {**os.environ, 'DEBIAN_FRONTEND': 'noninteractive', 'LC_ALL': 'C'}
    r = run(['apt-get', 'update', '-q'], capture_output=True, text=True, env=envc)
    if r.returncode != 0:
        return {'error': 'apt-get update a échoué (Internet disponible ?)'}
    r = subprocess.run(['apt', 'list', '--upgradable'], capture_output=True, text=True, env=envc)
    pkgs = []
    for line in r.stdout.splitlines():
        m = re.match(r'^([^/\s]+)/\S+\s+(\S+)\s+\S+\s+\[upgradable from: ([^\]]+)\]', line)
        if m:
            pkgs.append({'name': m.group(1), 'new': m.group(2), 'old': m.group(3)})
    return {'count': len(pkgs), 'packages': pkgs[:400]}


def check_kit(env):
    d = kit_dir(env)
    if not d:
        return {'error': 'Dossier du kit introuvable (installé sans git ?)'}

    def git(*args):
        return subprocess.run(as_owner(d, ['git', '-C', d] + list(args)),
                              capture_output=True, text=True).stdout.strip()

    fetch = run(as_owner(d, ['git', '-C', d, 'fetch', '--quiet']), capture_output=True, text=True)
    if fetch.returncode != 0:
        log('  ' + (fetch.stderr or '').strip().replace('\n', ' | ')[:300])
    info = {
        'dir': d,
        'branch': git('rev-parse', '--abbrev-ref', 'HEAD'),
        'local': git('rev-parse', '--short', 'HEAD'),
        'local_date': git('log', '-1', '--format=%cs'),
        'remote': git('rev-parse', '--short', '@{u}'),
        'fetch_error': fetch.returncode != 0,
        'dirty': bool(git('status', '--porcelain', '--untracked-files=no')),
    }
    if not info['local']:
        return {'error': f"Impossible de lire le dépôt git dans {d}"}
    behind = git('rev-list', '--count', 'HEAD..@{u}')
    info['behind'] = int(behind) if behind.isdigit() else 0
    info['commits'] = []
    for line in git('log', '--format=%h|%cs|%s', '-n', '40', 'HEAD..@{u}').splitlines():
        parts = line.split('|', 2)
        if len(parts) == 3:
            info['commits'].append({'id': parts[0], 'date': parts[1], 'subject': parts[2]})
    return info


def do_update_check(env):
    info = {'checked': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
            'os': check_os(), 'kit': check_kit(env), 'reboot_required': reboot_needed()}
    write_json(UPDATES, info)
    return info


def action_update_check(env):
    info = do_update_check(env)
    n_os = info['os'].get('count', 0) if 'error' not in info['os'] else '?'
    n_kit = info['kit'].get('behind', 0) if 'error' not in info['kit'] else '?'
    return True, f"Recherche terminée : {n_os} paquet(s) système, {n_kit} mise(s) à jour de l'iGate."


def spawn_update(kind, script):
    unit = UPDATE_UNITS[kind]
    # Une seule à la fois : les deux utilisent apt (install.sh installe des paquets)
    for other in UPDATE_UNITS.values():
        if run(['systemctl', 'is-active', '--quiet', other]).returncode == 0:
            return False, 'Une mise à jour est déjà en cours.'
    run(['systemctl', 'reset-failed', unit], capture_output=True)
    with open(UPDATE_LOG, 'w', encoding='utf-8') as f:
        f.write(f"=== {datetime.now():%Y-%m-%d %H:%M:%S} ===\n")
    os.chmod(UPDATE_LOG, 0o644)
    r = run(['systemd-run', '--unit=' + unit, '--collect', '--quiet',
             '--property=TimeoutStartSec=infinity', '/bin/bash', '-c', script])
    if r.returncode != 0:
        return False, 'Impossible de lancer la mise à jour.'
    return True, 'Mise à jour lancée : suivez-la dans l\'onglet Mises à jour.'


def action_os_upgrade(env):
    script = f"""exec >>{UPDATE_LOG} 2>&1
export DEBIAN_FRONTEND=noninteractive
echo '>>> apt-get update'
apt-get update -q
echo '>>> apt-get full-upgrade'
apt-get -y -q -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold full-upgrade
rc=$?
apt-get -y -q autoremove
/usr/local/sbin/aprs-apply-config finish os $rc
"""
    return spawn_update('os', script)


def action_kit_update(env):
    d = kit_dir(env)
    if not d:
        return False, 'Dossier du kit introuvable (installé sans git ?)'
    user = env['IGATE_USER']
    owner = repo_owner(d)
    git_pull = 'git pull --ff-only' if owner == 'root' else f"runuser -u '{owner}' -- git pull --ff-only"
    script = f"""exec >>{UPDATE_LOG} 2>&1
cd '{d}' || exit 1
echo '>>> git pull'
if {git_pull}; then
    echo '>>> ./install.sh --skip-upgrade'
    IGATE_USER='{user}' ./install.sh --skip-upgrade </dev/null
    rc=$?
else
    rc=$?
    echo 'git pull a échoué : des fichiers du kit ont-ils été modifiés à la main ?'
fi
/usr/local/sbin/aprs-apply-config finish kit $rc
"""
    return spawn_update('kit', script)


def finish_update(env, kind, code):
    """Appelé par la tâche de mise à jour à la fin : nouveau bilan et statut."""
    ok = code == '0'
    log(f"=== Fin de la mise à jour ({kind}) : code {code}")
    try:
        do_update_check(env)
    except Exception as e:  # le statut compte plus que le bilan
        log(f"  bilan impossible : {e}")
    if kind == 'os':
        msg = 'Mise à jour du système terminée.' if ok else 'Échec de la mise à jour du système (voir le journal).'
    else:
        msg = "Mise à jour de l'iGate terminée." if ok else "Échec de la mise à jour de l'iGate (voir le journal)."
    if ok and reboot_needed():
        msg += ' Redémarrez le Pi pour terminer.'
    log(('✓ ' if ok else '✗ ') + msg)
    write_status('update-' + kind, ok, msg)
    return ok


HANDLERS = {
    'apply': action_apply, 'restart': action_restart, 'backup': action_backup,
    'usb-backup': action_usb_backup, 'tiles': action_tiles,
    'clear-tiles': action_clear_tiles, 'gain-test': action_gain_test, 'reboot': action_reboot,
    'network': action_network, 'network-confirm': action_network_confirm,
    'update-check': action_update_check, 'os-upgrade': action_os_upgrade, 'kit-update': action_kit_update,
}
PAYLOAD_ACTIONS = ('network',)   # actions qui reçoivent un paramètre (contenu du fichier de demande)


def do(action, env, payload=''):
    log(f"=== Action : {action}" + (f" ({payload})" if payload else ''))
    try:
        ok, msg = HANDLERS[action](env, payload) if action in PAYLOAD_ACTIONS else HANDLERS[action](env)
    except Exception as e:  # on veut toujours un statut lisible dans /admin
        ok, msg = False, f"Erreur : {e}"
    log(('✓ ' if ok else '✗ ') + msg)
    write_status(action, ok, msg)
    return ok


def process_queue(env):
    os.makedirs(QUEUE, exist_ok=True)
    ok = True
    for name in sorted(os.listdir(QUEUE)):
        path = os.path.join(QUEUE, name)
        try:
            with open(path, encoding='utf-8', errors='replace') as f:
                payload = f.read(200).strip()
            os.remove(path)          # retirer d'abord : pas de boucle infinie
        except OSError:
            continue
        action = name.split('-', 1)[-1]
        if action not in ACTIONS:
            log(f"Demande ignorée (inconnue) : {name}")
            continue
        ok = do(action, env, payload if action in PAYLOAD_ACTIONS else '') and ok
    return ok


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else 'apply'
    if arg == 'get':
        # Lecture d'un réglage (utilisé par les scripts bash) : pas besoin de root
        s, _ = load_settings()
        key = sys.argv[2] if len(sys.argv) > 2 else ''
        if key == 'station':
            print(station_name(s))
        elif key in s:
            v = s[key]
            print(('yes' if v else 'no') if isinstance(v, bool) else v)
        else:
            raise SystemExit(f"Réglage inconnu : {key}")
        return
    if os.geteuid() != 0:
        raise SystemExit("Ce script doit être lancé en root (sudo).")
    env = read_install_env()
    if arg == 'finish' and len(sys.argv) == 4 and sys.argv[2] in UPDATE_UNITS:
        sys.exit(0 if finish_update(env, sys.argv[2], sys.argv[3]) else 1)
    if arg == '--queue':
        process_queue(env)
        sys.exit(0)  # le résultat est dans status.json ; ne pas bloquer l'unité .path
    if arg not in ACTIONS:
        raise SystemExit(__doc__)
    sys.exit(0 if do(arg, env) else 1)


if __name__ == '__main__':
    main()
