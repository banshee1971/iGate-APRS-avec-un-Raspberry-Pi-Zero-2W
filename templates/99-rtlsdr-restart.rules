# Redémarrer aprs-igate quand un RTL-SDR (RTL2832U) se reconnecte
# (try-restart : seulement si l'iGate tourne déjà, donc configuré dans /admin)
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="2838", RUN+="/bin/systemctl --no-block try-restart aprs-igate.service"
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="2832", RUN+="/bin/systemctl --no-block try-restart aprs-igate.service"
